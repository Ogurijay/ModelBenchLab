{
  "name": "model-bench-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI 模型能力测试合集 — 不同模型生成的 3D 场景对比。项目清单与端口以 benchmark/registry.json 为单一事实源。",
  "workspaces": [
    "claudeopus4.8-ocean-webgpu",
    "gpt5.5-ocean-weather",
    "doubao2.1-ocean-webgpu",
    "gpt5.5-ocean-skill",
    "claudefable5-ocean-realistic",
    "geminiflash3.5-ocean-realistic",
    "gpt5.5-ocean-realistic",
    "grok4.3-ocean-realistic",
    "geminiflash3.5-ocean-storm",
    "claudesonnet5-ocean-storm",
    "claudefable5-kart-circuit",
    "geminiflash3.5-kart-circuit",
    "gpt5.5-kart-circuit",
    "claudeopus4.8-gsapthreetest",
    "gpt5.5-ocean-webgpu",
    "gpt5.5-tank3D",
    "claudesonnet5-tank3D",
    "gpt5.5-powdergame",
    "mimov2.5-powdergame",
    "claudefable5-powdergame",
    "doubao2.1pro-powdergame",
    "geminiflash3.5-powdergame"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:one": "node scripts/dev-all.mjs",
    "dev:portal": "vite --port 3000 --strictPort",
    "sync:check": "node scripts/sync-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^8.0.16"
  }
}
